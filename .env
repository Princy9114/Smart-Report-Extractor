# ===========================================================================
# Smart Report Extractor - Environment Configuration
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. LLM Provider Mode
# ---------------------------------------------------------------------------
# Options: "auto" (default), "ollama", "local", "gemini", or "none"
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# 2. Local Ollama Settings (Zero-Cost & 100% Private)
# ---------------------------------------------------------------------------
# Base URL where Ollama is running (default is http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use in Ollama (e.g. llama3.2, llama3.1:8b, mistral:7b, phi3)
OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# 3. Google Gemini Settings (Cloud API - Optional Alternative)
# ---------------------------------------------------------------------------
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# 4. Custom OpenAI-Compatible Local Endpoint (vLLM / LM Studio - Optional)
# ---------------------------------------------------------------------------
# LOCAL_LLM_URL=http://localhost:8000/v1/chat/completions
# LOCAL_LLM_MODEL=local-model
